<mvc:View
    controllerName="casais.equipment.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <f:DynamicPage id="detailPage" fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" press=".onNavBack" tooltip="Back"/>
                </f:navigationActions>
                <f:heading>
                    <Title text="{name}" level="H1"/>
                </f:heading>
                <f:snappedContent>
                    <Text text="{equipmentCode}"/>
                </f:snappedContent>
                <f:actions>
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="Refresh"
                        press=".onRefresh"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap" class="sapUiSmallMargin">
                    <VBox class="sapUiSmallMarginEnd">
                        <ObjectStatus
                            title="Status"
                            text="{status}"
                            state="{= ${status} === 'AVAILABLE' ? 'Success' :
                                     ${status} === 'IN_USE'    ? 'Information' :
                                     ${status} === 'MAINTENANCE' ? 'Warning' : 'None' }"/>
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd">
                        <ObjectStatus
                            title="Open Fault"
                            icon="{= ${path:'hasOpenFault', targetType:'any'} === true ? 'sap-icon://alert' : 'sap-icon://accept' }"
                            state="{= ${path:'hasOpenFault', targetType:'any'} === true ? 'Error' : 'Success' }"
                            text="{= ${path:'hasOpenFault', targetType:'any'} === true ? 'Yes' : 'No' }"/>
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd">
                        <ObjectStatus title="Project" text="{assignedProject}"/>
                    </VBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>
                <Panel headerText="Dados Mestre SAP" expandable="true" expanded="true" class="sapUiResponsiveMargin">
                    <VBox class="sapUiTinyMarginBegin sapUiTinyMarginBottom">
                        <Text text="SAP Master Data" class="sapUiTinyMarginBottom"
                            style="font-size: 0.75rem; color: #005EB8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;"/>
                    </VBox>
                    <form:SimpleForm editable="false" layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                        columnsXL="2" columnsL="2" columnsM="1">
                        <form:content>
                            <Label text="SAP Equipment ID"/>
                            <Text text="{sapEquipmentId}"/>
                            <Label text="N.º Ativo SAP"/>
                            <Text text="{sapAssetNumber}"/>
                            <Label text="N.º Série"/>
                            <Text text="{serialNumber}"/>
                            <Label text="Marca"/>
                            <Text text="{brand}"/>
                            <Label text="Modelo"/>
                            <Text text="{model}"/>
                            <Label text="Fabricante"/>
                            <Text text="{manufacturer}"/>
                            <Label text="Categoria"/>
                            <Text text="{category}"/>
                            <Label text="Valor de Aquisição (€)"/>
                            <Text text="{
                                path: 'acquisitionValue',
                                type: 'sap.ui.model.odata.type.Decimal',
                                formatOptions: { decimals: 2 },
                                constraints: { scale: 2 }
                            }"/>
                            <Label text="Data de Aquisição"/>
                            <Text text="{acquisitionDate}"/>
                            <Label text="Centro de Custo"/>
                            <Text text="{costCenter}"/>
                            <Label text="Instalação SAP"/>
                            <Text text="{plant}"/>
                            <Label text="Local de Armazenagem"/>
                            <Text text="{storageLocation}"/>
                            <Label text="Estado Técnico"/>
                            <ObjectStatus
                                text="{technicalStatus}"
                                state="{= ${technicalStatus} === 'OPERATIONAL' ? 'Success' :
                                         ${technicalStatus} === 'INSPECTION_DUE' ? 'Warning' :
                                         ${technicalStatus} === 'DEFECTIVE' ? 'Error' : 'None' }"/>
                            <Label text="Origem"/>
                            <Text text="{source}"/>
                            <Label text="Última Sincronização SAP"/>
                            <Text text="{lastSapSyncAt}"/>
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <Panel headerText="Operational Status" expandable="true" expanded="true" class="sapUiResponsiveMargin">
                    <form:SimpleForm editable="false" layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                        columnsXL="2" columnsL="2" columnsM="1">
                        <form:content>
                            <Label text="Tag NFC (PWA)"/>
                            <ObjectStatus
                                icon="{= ${rfidTag} ? 'sap-icon://tag' : 'sap-icon://pending' }"
                                text="{= ${rfidTag} ? ${rfidTag} : 'Pendente de etiquetagem na PWA'}"
                                state="{= ${rfidTag} ? 'Success' : 'None' }"/>
                            <Label text="Localização"/>
                            <Text text="{currentLocationName}"/>
                            <Label text="Última Leitura NFC"/>
                            <Text text="{= ${lastSeenAt} ? ${lastSeenAt} : '—'}"/>
                            <Label text="Lido por"/>
                            <Text text="{= ${lastSeenBy} ? ${lastSeenBy} : '—'}"/>
                            <Label text="Latitude"/>
                            <Text text="{latitude}"/>
                            <Label text="Longitude"/>
                            <Text text="{longitude}"/>
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <Panel headerText="Commercial Data" expandable="true" expanded="true" class="sapUiResponsiveMargin">
                    <form:SimpleForm editable="false" layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                        columnsXL="2" columnsL="2" columnsM="1">
                        <form:content>
                            <Label text="Replacement Value"/>
                            <Text text="{
                                path: 'replacementValue',
                                type: 'sap.ui.model.odata.type.Decimal',
                                formatOptions: { decimals: 2 },
                                constraints: { scale: 2 }
                            }"/>
                            <Label text="Criticality"/>
                            <Text text="{criticality}"/>
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <Panel headerText="Fault Reports" expandable="true" expanded="true" class="sapUiResponsiveMargin">
                    <Table id="faultsTable"
                        items="{faults}"
                        noDataText="No fault reports">
                        <columns>
                            <Column><Text text="Type"/></Column>
                            <Column><Text text="Status"/></Column>
                            <Column><Text text="Reported At"/></Column>
                            <Column><Text text="Reported By"/></Column>
                            <Column><Text text="Description"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{faultType}"/>
                                    <ObjectStatus text="{status}" state="{= ${status} === 'OPEN' ? 'Error' : 'Success'}"/>
                                    <Text text="{reportedAt}"/>
                                    <Text text="{reportedBy}"/>
                                    <Text text="{description}" wrapping="true"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <Panel headerText="Movements" expandable="true" expanded="true" class="sapUiResponsiveMargin">
                    <Table id="movementsTable"
                        items="{movements}"
                        noDataText="No movements recorded">
                        <columns>
                            <Column><Text text="Type"/></Column>
                            <Column><Text text="From"/></Column>
                            <Column><Text text="To"/></Column>
                            <Column><Text text="Date"/></Column>
                            <Column><Text text="By"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{movementType}"/>
                                    <Text text="{fromLocation}"/>
                                    <Text text="{toLocation}"/>
                                    <Text text="{createdAt}"/>
                                    <Text text="{createdBy}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
