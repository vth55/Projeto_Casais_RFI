{
  "name": "casais-fiori-demo",
  "version": "0.1.0",
  "private": true,
  "description": "SAP BTP CAP/Fiori demo for CASAIS Fleet Intelligence integration.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "deploy:sqlite": "cds deploy --to sqlite",
    "test": "cds compile srv --to edmx > .tmp-equipment-service.edmx"
  },
  "dependencies": {
    "@cap-js/postgres": "^1",
    "@cap-js/sqlite": "^1",
    "@sap/cds": "^8.9",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8.9"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      },
      "[production]": {
        "db": {
          "kind": "postgres",
          "migrate": "auto"
        },
        "auth": "dummy"
      }
    },
    "odata": {
      "version": "v4"
    }
  }
}
