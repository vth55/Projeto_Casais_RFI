/*
 * MIGRATION PROPOSAL: alerts/ legacy collection
 *
 * WHY NOT CHANGING NOW:
 * The `alerts/` collection is accessed by a token-gated flow:
 *   - `autoCloseStuckSessions` and `checkLongSessions` in index.js write to `alerts/`
 *   - `useAlertsStore.js` reads/updates `alerts/` directly from the frontend (allow read: if true)
 *   - `ValidationPage.jsx` reads token from URL and queries `tool_alerts` (new) OR `alerts` (legacy)
 *     depending on the alert's collection flag
 *   - `resendAlertEmail` HTTP endpoint validates alert token server-side and updates `alerts/`
 * Changing `allow read: if true` to authenticated-only would break the public email validation
 * links before the legacy flow is fully migrated.
 *
 * SAFE MIGRATION SEQUENCE:
 * Step 1: Add `collectionType` field ('legacy' | 'tool') to new alerts written by Cloud Functions
 * Step 2: Migrate `ValidationPage.jsx` to handle both collections (already partially done)
 * Step 3: Migrate `autoCloseStuckSessions` and `checkLongSessions` to write to `tool_alerts`
 * Step 4: Migrate `useAlertsStore.js` to read from `tool_alerts` instead of `alerts`
 * Step 5: Once no new docs are written to `alerts/`, tighten rules to `allow read: if isAuthenticated()`
 * Step 6: Archive/delete legacy `alerts/` documents
 *
 * BLOCKER: Steps 3-4 require coordinated deploy of both Functions and Frontend. Until then,
 * `allow read: if true` and `allow update: if true` on `alerts/` must remain.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // Helpers
    // ============================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/artifacts/casais-rfid/public/data/users/$(request.auth.uid))
          .data.systemRole in ['admin', 'it'];
    }
    function hasSystemRole(roles) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/artifacts/casais-rfid/public/data/users/$(request.auth.uid))
          .data.systemRole in roles;
    }
    function canManageLogistics() {
      return hasSystemRole(['admin', 'it', 'gestor', 'gestor_frota', 'logistica', 'encarregado_obra']);
    }
    function canManageEquipment() {
      return hasSystemRole(['admin', 'it', 'gestor', 'gestor_frota']);
    }
    function canManageMaintenance() {
      return hasSystemRole(['admin', 'it', 'gestor', 'gestor_frota', 'tecnico_manutencao']);
    }
    function isToolOperationalUpdate() {
      return isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'currentObraId',
          'currentObraName',
          'storageLocation',
          'logisticsStatus',
          'pendingTransferId',
          'pendingDestinationObraId',
          'pendingDestinationName',
          'lastMovementAt',
          'lastConfirmedAt',
          'lastConfirmedBy',
          'maintenanceStatusUpdatedAt',
          'lastMaintenanceId',
          'lostAt',
          'updatedAt'
        ]);
    }
    // Returns true when the update touches ONLY personal fields (no privilege escalation)
    function isPersonalProfileUpdate() {
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      let allowed  = ['displayName', 'photoURL', 'lastSeenAt', 'notificationPrefs', 'theme'];
      let blocked  = ['systemRole', 'permissions', 'roleId', 'level', 'assignedObraId',
                      'isActive', 'createdAt', 'createdBy'];
      return touched.hasOnly(allowed) && !touched.hasAny(blocked);
    }

    // Returns true when caller is gestor_frota, admin, or it (level <= 1)
    function canReadAllUsers() {
      return hasSystemRole(['admin', 'it', 'gestor_frota']);
    }

    function assignedObraId() {
      return request.auth.token.assignedObraId;
    }

    function hasAssignedObraClaim() {
      return isAuthenticated() &&
        request.auth.token.assignedObraId is string &&
        request.auth.token.assignedObraId != '';
    }

    function isRestrictedToOwnObra() {
      return isAuthenticated() &&
        request.auth.token.restrictedToOwnObra == true;
    }

    function canAccessObraId(obraId) {
      return !isRestrictedToOwnObra() ||
        (hasAssignedObraClaim() && obraId == assignedObraId());
    }

    function hasObraScope(data) {
      return data.keys().hasAny(['obraScopeIds']) &&
        data.obraScopeIds is list;
    }

    function canAccessObraScope(data) {
      return !isRestrictedToOwnObra() ||
        (hasAssignedObraClaim() &&
         hasObraScope(data) &&
         data.obraScopeIds.hasAny([assignedObraId()]));
    }

    function mapHasOwnObra(location) {
      return location is map &&
        location.keys().hasAny(['obraId']) &&
        location.obraId == assignedObraId();
    }

    function transferTouchesOwnObra(data) {
      return !isRestrictedToOwnObra() ||
        (hasAssignedObraClaim() &&
         (
           (hasObraScope(data) && data.obraScopeIds.hasAny([assignedObraId()])) ||
           (data.keys().hasAny(['from']) && mapHasOwnObra(data.from)) ||
           (data.keys().hasAny(['to']) && mapHasOwnObra(data.to))
         ));
    }

    function movementTouchesOwnObra(data) {
      return !isRestrictedToOwnObra() ||
        (hasAssignedObraClaim() &&
         (
           (hasObraScope(data) && data.obraScopeIds.hasAny([assignedObraId()])) ||
           (data.keys().hasAny(['fromObraId']) && data.fromObraId == assignedObraId()) ||
           (data.keys().hasAny(['toObraId']) && data.toObraId == assignedObraId())
         ));
    }

    function canUpdateToolOperationally() {
      return isToolOperationalUpdate() &&
        (
          !isRestrictedToOwnObra() ||
          (
            hasAssignedObraClaim() &&
            (
              resource.data.currentObraId == assignedObraId() ||
              request.resource.data.currentObraId == assignedObraId() ||
              resource.data.pendingDestinationObraId == assignedObraId() ||
              request.resource.data.pendingDestinationObraId == assignedObraId()
            )
          )
        );
    }

    // ============================================
    // Colecções primárias do pivot (escritas controladas)
    // ============================================
    match /artifacts/casais-rfid/public/data/equipment_models/{modelId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if canManageEquipment();
    }

    match /artifacts/casais-rfid/public/data/tools/{toolId} {
      allow read: if isAuthenticated();
      allow create, delete: if canManageEquipment();
      allow update: if canManageEquipment() || canUpdateToolOperationally();
    }

    match /artifacts/casais-rfid/public/data/tool_sessions/{sessionId} {
      allow read: if isAuthenticated() && canAccessObraId(resource.data.obraId);
      // Operador pode criar a sua própria sessão e fechá-la
      allow create: if isAuthenticated() &&
        request.resource.data.operatorId == request.auth.uid &&
        canAccessObraId(request.resource.data.obraId);
      allow update: if isAuthenticated() &&
        (resource.data.operatorId == request.auth.uid || canManageMaintenance()) &&
        canAccessObraId(resource.data.obraId);
      allow delete: if canManageEquipment();
    }

    match /artifacts/casais-rfid/public/data/tool_alerts/{alertId} {
      // H2-2C: mantem global autenticado. tool_alerts ainda nao tem obraId canonico
      // e SAP_SYNC_FAILURE e global. Apertar isto fica para a migracao H2-1 alerts.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // qualquer auth pode criar alerta
      allow update: if isAuthenticated(); // todos podem actualizar (audit log append)
      allow delete: if canManageMaintenance();
    }

    match /artifacts/casais-rfid/public/data/tool_maintenance/{recordId} {
      allow read: if isAuthenticated() && canAccessObraId(resource.data.obraId);
      allow create: if canManageMaintenance() ||
        (
          isAuthenticated() &&
          request.resource.data.type == 'DAMAGE' &&
          request.resource.data.reportedBy == request.auth.uid &&
          canAccessObraId(request.resource.data.obraId)
        );
      allow update: if canManageMaintenance() && canAccessObraId(resource.data.obraId);
      allow delete: if canManageMaintenance();
    }

    match /artifacts/casais-rfid/public/data/tool_movements/{movementId} {
      allow read: if isAuthenticated() && canAccessObraScope(resource.data);
      allow create: if canManageLogistics() && movementTouchesOwnObra(request.resource.data);
      allow update: if canManageLogistics() && movementTouchesOwnObra(request.resource.data);
      allow delete: if canManageLogistics() && movementTouchesOwnObra(resource.data);
    }

    match /artifacts/casais-rfid/public/data/tool_transfers/{transferId} {
      allow read: if isAuthenticated() && transferTouchesOwnObra(resource.data);
      allow create, update: if canManageLogistics() && transferTouchesOwnObra(request.resource.data);
      allow delete: if canManageLogistics() && transferTouchesOwnObra(resource.data);
    }

    // ============================================
    // Colecções secundárias
    // ============================================
    match /artifacts/casais-rfid/public/data/obras/{obraId} {
      allow read: if isAuthenticated() && canAccessObraId(obraId);
      allow create, update, delete: if canManageEquipment();
    }

    match /artifacts/casais-rfid/public/data/operators/{operatorId} {
      allow read: if isAuthenticated();
      allow update: if canManageEquipment();
      allow create, delete: if canManageEquipment();
    }

    match /artifacts/casais-rfid/public/data/settings/{document} {
      allow read: if isAuthenticated();
      allow write: if canManageEquipment();
    }

    // ============================================
    // Users (perfil systemRole) — RBAC granular
    // ============================================
    match /artifacts/casais-rfid/public/data/users/{userId} {
      // Leitura do próprio perfil: sempre permitida a qualquer auth
      // Leitura de outros perfis: apenas gestor_frota, admin, it
      allow read: if request.auth.uid == userId || canReadAllUsers();

      // Criação e deleção: apenas admin
      allow create, delete: if isAdmin();

      // Update pelo próprio utilizador: APENAS campos pessoais (sem privilege escalation)
      // Update por admin/it: quaisquer campos incluindo privilegiados
      allow update: if isAdmin() ||
        (isAuthenticated() &&
         request.auth.uid == userId &&
         isPersonalProfileUpdate());
    }

    match /artifacts/casais-rfid/public/data/maintenance_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if canManageMaintenance();
    }

    match /artifacts/casais-rfid/public/data/location_cards/{cardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if canManageLogistics();
    }

    match /artifacts/casais-rfid/public/data/scan_buffer/{documentId} {
      allow read: if isAuthenticated();
      allow write: if canManageLogistics();
    }

    // A raiz contém tokens OAuth. Apenas administração pode lê-la.
    match /artifacts/casais-rfid/public/data/integrations/procore {
      allow read, write: if isAdmin();
    }

    // Os mirrors não contêm tokens e alimentam a UI autenticada.
    match /artifacts/casais-rfid/public/data/integrations/procore/projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /artifacts/casais-rfid/public/data/integrations/procore/directory/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /artifacts/casais-rfid/public/data/integrations/procore/equipment/{equipmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /artifacts/casais-rfid/public/data/sap_sync_log/{logId} {
      allow read: if isAdmin();
    }

    // ============================================
    // Procore legacy (mantidas)
    // ============================================
    match /artifacts/casais-rfid/public/data/sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if canManageEquipment();
    }

    match /artifacts/casais-rfid/public/data/machines/{machineId} {
      allow read: if isAuthenticated();
      allow write: if canManageEquipment();
    }

    // Legacy collections remain isolated while compatibility widgets and
    // Procore reconciliation are still available.
    match /artifacts/casais-rfid/public/data/maintenance/{recordId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if canManageMaintenance();
    }

    match /artifacts/casais-rfid/public/data/avarias/{recordId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if canManageMaintenance();
    }

    match /artifacts/casais-rfid/public/data/machineLocationEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if canManageLogistics();
      allow update, delete: if isAdmin();
    }

    match /artifacts/casais-rfid/public/data/alerts/{alertId} {
      // Acesso via token público (validação por email) — ver MIGRATION PROPOSAL no topo
      allow read: if true;
      allow update: if true; // token-gated no backend
      allow create, delete: if isAdmin();
    }
  }
}
